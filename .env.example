# Claude (Anthropic API): primary AI for ingestion, tutor, concepts, course, quiz and grading.
# Get a key at https://platform.claude.com/settings/keys . When empty, the backends below are used.
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-opus-5-5, effort medium / low for quick jobs)
AI_CLAUDE_MODEL=
AI_CLAUDE_EFFORT=

# Primary LLM: self-hosted Projust AI server on the Windows laptop (optional).
# When set, requests go here first and fall back to the LLM_* provider below if it's down or slow.
AI_SERVER_URL=
AI_SERVER_KEY=
AI_SERVER_MODEL=projust-main
AI_SERVER_FAST_MODEL=projust-fast
AI_SERVER_CONNECT_TIMEOUT_MS=8000
AI_SERVER_COOLDOWN_MS=60000

# Optional second backend, tried after the AI server and before the fallback.
# Any OpenAI-compatible API works, e.g. OpenCode Zen: LLM_ALT_BASE_URL=https://opencode.ai/zen/v1
LLM_ALT_BASE_URL=
LLM_ALT_API_KEY=
LLM_ALT_MODEL=
LLM_ALT_FAST_MODEL=

# Fallback LLM (OpenAI-compatible; default OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
LLM_FAST_MODEL=deepseek/deepseek-chat

# GitHub repo-access OAuth app (separate from the login app)
GITHUB_REPO_CLIENT_ID=
GITHUB_REPO_CLIENT_SECRET=
GITHUB_SERVER_TOKEN=

# Security
# Replace with your own: openssl rand -base64 32  (this example value is public)
TOKEN_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS0xMjM0NQ==
# Signs login sessions. If empty, one is derived from TOKEN_ENCRYPTION_KEY.
# Changing it signs everyone out. Generate: openssl rand -base64 48
SESSION_SECRET=
# Set to false in production to turn off the "demo data" sign-in
ALLOW_DEMO_MODE=true

# Limits
MAX_REPO_ARCHIVE_MB=25
MAX_FILES_PER_PROJECT=400
MAX_FILE_KB=100
ASK_CONTEXT_TOKEN_BUDGET=60000
FREE_DAILY_ASK_LIMIT=20

# Firebase Auth
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase (Database)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
